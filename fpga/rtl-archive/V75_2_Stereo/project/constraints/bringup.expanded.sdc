# B28 faster DPHY LP-state controller, exact first-stage/event/reset entries.
set_false_path -from [get_regs {rx_enable}] -to [get_regs {receiver/enable_sync[0]}]
set_false_path -from [get_regs {receiver/timeout_event}] -to [get_regs {phy_timeout_sync[0]}]
set_false_path -from [get_regs {startup[19] storage/memory/ph1p_ddrmc_wrapper/ph1p_ddrmc_top/u_ddr_phy/u_ddrphy_top/sys_rst_n}] -to [get_regs {receiver/control_reset[*]}]

# B30 pixel measurement -> motor-control frozen mailbox; all other paths timed.
set_false_path -from [get_regs {gimbal_capture/request}] -to [get_regs {gimbal_capture/request_sync[0]}]
set_false_path -from [get_regs {gimbal_capture/ack}] -to [get_regs {gimbal_capture/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {gimbal_capture/frozen[*]}] -to [get_regs {gimbal_capture/read_data[*]}]
set_false_path -from [get_regs {startup[19]}] -to [get_regs {gimbal_capture/source_reset[*] gimbal_capture/read_reset[*]}]
set_false_path -from [get_pins {clocks/video_pll.lock}] -to [get_regs {gimbal_capture/source_reset[*] gimbal_capture/read_reset[*]}]
set_false_path -from [get_ports {key_n[2]}] -to [get_regs {gimbal_stop_sync[0]}]

# Selected-colour mailbox: same frozen request/ack protocol.
set_false_path -from [get_regs {gimbal_colour_mode/request}] -to [get_regs {gimbal_colour_mode/request_sync[0]}]
set_false_path -from [get_regs {gimbal_colour_mode/ack}] -to [get_regs {gimbal_colour_mode/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {gimbal_colour_mode/held_mode[*]}] -to [get_regs {gimbal_colour_mode/pending_mode[*]}]
set_false_path -from [get_regs {startup[19] storage/memory/ph1p_ddrmc_wrapper/ph1p_ddrmc_top/u_ddr_phy/u_ddrphy_top/sys_rst_n}] -to [get_regs {gimbal_colour_mode/src_reset[*] gimbal_colour_mode/dst_reset[*]}]
set_false_path -from [get_pins {clocks/video_pll.lock}] -to [get_regs {gimbal_colour_mode/src_reset[*] gimbal_colour_mode/dst_reset[*]}]

# Rebalanced new cache/mailbox bounds applied before placement.
# Metric mailboxes: only first scalar synchronizer entries. Second stages and business paths remain timed.
set_false_path -from [get_regs {metric_pause/host_requested}] -to [get_regs {metric_pause/request_sync[0]}]
set_false_path -from [get_regs {metric_pause/release_toggle}] -to [get_regs {metric_pause/release_sync[0]}]
set_false_path -from [get_regs {metric_pause/memory_hold_confirmed}] -to [get_regs {metric_pause/held_sync[0]}]
set_false_path -from [get_regs {metric_pause/release_ack}] -to [get_regs {metric_pause/release_ack_sync[0]}]
set_false_path -from [get_regs {metric_tap/request_toggle}] -to [get_regs {metric_tap/request_sync[0]}]
set_false_path -from [get_regs {metric_tap/ack_toggle}] -to [get_regs {metric_tap/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_pause/held_job[*]}] -to [get_regs {metric_pause/host_job[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_pause/held_sources[*]}] -to [get_regs {metric_pause/host_source_pair[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/row_mailbox[*]}] -to [get_regs {metric_tap/target_row[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/job_mailbox[*]}] -to [get_regs {metric_tap/target_job[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/return_job[*]}] -to [get_regs {metric_tap/host_job[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/return_row[*]}] -to [get_regs {metric_tap/host_returned_row[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/return_error[*]}] -to [get_regs {metric_tap/host_error[*]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_tap/return_good}] -to [get_regs {metric_tap/host_valid}]

# B54 KEY2 owns depth mode; noise toggle is host-only.
set_false_path -from [get_ports {key_n[1]}] -to [get_regs {depth_key_control/key_sync[0]}]

# Same frozen response mailbox contract as the established B26 depth cache.
# Payload is captured only after the two-stage ACK has reached the pixel
# domain. Bound DATA paths to 20 ns; keep hold checks and all other paths timed.

# First synchronizer entries only. Second stages and functional data stay timed.
set_false_path -from [get_regs {cloud_run_mode/request}] -to [get_regs {cloud_run_mode/request_sync[0]}]
set_false_path -from [get_regs {cloud_run_mode/ack}] -to [get_regs {cloud_run_mode/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {cloud_run_mode/held_mode[*]}] -to [get_regs {cloud_run_mode/pending_mode[*]}]
set_false_path -from [get_regs {cloud_capture/request}] -to [get_regs {cloud_capture/request_sync[0]}]
set_false_path -from [get_regs {cloud_capture/ack}] -to [get_regs {cloud_capture/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {cloud_capture/frozen[*]}] -to [get_regs {cloud_capture/read_data[*]}]
# B64 same-held-data handshake as the native/depth caches. First stages only.
set_false_path -from [get_regs {tr_ready_memory}] -to [get_regs {tr_ready_sync[0]}]
set_false_path -from [get_regs {metric_transport/req_toggle}] -to [get_regs {metric_transport/req_sync[0]}]
set_false_path -from [get_regs {metric_transport/ack_toggle}] -to [get_regs {metric_transport/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_transport/requested_row[*] metric_transport/requested_bank metric_transport/requested_new metric_transport/requested_row[*]_dup_* metric_transport/requested_bank_dup_* metric_transport/requested_new_dup_*}] -to [get_regs {metric_transport/memory_row[*] metric_transport/memory_bank metric_transport/memory_new metric_transport/memory_row[*]_dup_* metric_transport/memory_bank_dup_* metric_transport/memory_new_dup_*}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_transport/response_good}] -to [get_regs {metric_transport/ready_bits[*] metric_transport/source_frame_valid}]
set_max_delay -datapath_only 20.000 -from [get_regs {metric_transport/response_frame_id[*]}] -to [get_regs {metric_transport/source_frame_id[*]}]
set_false_path -from [get_ports {key_n[3]}] -to [get_regs {tracking_key/key_sync[0]}]
set_false_path -from [get_regs {tracking_quiet_memory}] -to [get_regs {tracking_quiet_sync[0]}]
set_false_path -from [get_regs {follow_target_capture/request}] -to [get_regs {follow_target_capture/request_sync[0]}]
set_false_path -from [get_regs {follow_target_capture/ack}] -to [get_regs {follow_target_capture/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {follow_target_capture/held_data[*]}] -to [get_regs {follow_host_payload[*]}]
