set_false_path -from [get_regs {transport_metadata/request}] -to [get_regs {transport_metadata/request_sync[0]}]
set_false_path -from [get_regs {transport_metadata/ack}] -to [get_regs {transport_metadata/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {transport_metadata/held_mode[*]}] -to [get_regs {transport_metadata/pending_mode[*]}]
set_false_path -from [get_regs {rgb_cloud/cloud_present/request}] -to [get_regs {rgb_cloud/cloud_present/request_sync[0]}]
set_false_path -from [get_regs {rgb_cloud/cloud_present/ack}] -to [get_regs {rgb_cloud/cloud_present/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {rgb_cloud/cloud_present/held_mode[*]}] -to [get_regs {rgb_cloud/cloud_present/pending_mode[*]}]
set_false_path -from [get_regs {cloud_capture/request}] -to [get_regs {cloud_capture/request_sync[0]}]
set_false_path -from [get_regs {cloud_capture/ack}] -to [get_regs {cloud_capture/ack_sync[0]}]
set_max_delay -datapath_only 20.000 -from [get_regs {cloud_capture/frozen[*]}] -to [get_regs {cloud_capture/read_data[*]}]
