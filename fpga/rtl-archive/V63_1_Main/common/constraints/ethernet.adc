# HX1P35A, PH1P35MDG324, BANK22 at 3.3V; cross-checked vendor schematic.
# PHY TXC uses PLL +90deg. DO NOT also add the vendor OUTDEL=3.
set_pin_assignment {eth_rxc}    {LOCATION=V3; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_rx_ctl} {LOCATION=N8; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_rxd[0]} {LOCATION=N9; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_rxd[1]} {LOCATION=T7; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_rxd[2]} {LOCATION=T8; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_rxd[3]} {LOCATION=T9; IOSTANDARD=LVCMOS33; PULLTYPE=NONE;}
set_pin_assignment {eth_txc}    {LOCATION=U9; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_tx_ctl} {LOCATION=R10; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_txd[0]} {LOCATION=R11; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_txd[1]} {LOCATION=P11; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_txd[2]} {LOCATION=T10; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_txd[3]} {LOCATION=R12; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_reset_n} {LOCATION=V8; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_mdc}    {LOCATION=V9; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
set_pin_assignment {eth_mdio}   {LOCATION=U10; IOSTANDARD=LVCMOS33; DRIVESTRENGTH=8; PULLTYPE=NONE;}
